# ============================================================
# DataTalk — Git Ignore
# ============================================================

# Environment variables and secrets
.env
.env.*
!.env.example

# Python virtual environments
.venv/
venv/
env/
ENV/

# Python bytecode and cache
__pycache__/
*.py[cod]
*$py.class
.pytype/
.python-version.local

# Packaging and build artifacts
build/
dist/
*.egg-info/
.eggs/
wheels/
pip-wheel-metadata/

# Testing and coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
test-results/
junit.xml

# Linting, formatting, and type checking
.ruff_cache/
.mypy_cache/
.pyre/
.dmypy.json
.pyright/
.hypothesis/

# Jupyter Notebook
.ipynb_checkpoints/

# Streamlit local configuration and secrets
.streamlit/secrets.toml
# .streamlit/config.toml

# Application logs and temporary files
*.log
logs/
tmp/
temp/
*.tmp
*.temp
*.bak
*.swp
*.swo
*.orig

# Local databases
*.sqlite
*.sqlite3
*.db

# OS-generated files
.DS_Store
.DS_Store?
Thumbs.db
Desktop.ini

# IDE and editor settings
.vscode/
.idea/
*.code-workspace

# Local environment and tool artifacts
.python_history
pip-log.txt
pip-delete-this-directory.txt
# Persistent assistant answers (may contain private aggregate evidence)
# /qa.json
/qa.json.lock
/qa.json.tmp
