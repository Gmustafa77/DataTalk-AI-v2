
DATABRICKS_SERVER_HOSTNAME="write_your_own" 
DATABRICKS_HTTP_PATH="write_your_own"
DATABRICKS_ACCESS_TOKEN="write_your_own"
DATABRICKS_CATALOG="my_catalog" 
DATABRICKS_SCHEMA="default"
DATABRICKS_TABLE="appeals_final"


# 0 = keep loaded table until "Refresh data"; otherwise seconds
DATA_CACHE_TTL_SECONDS=0

GROQ_API_KEY=write_your_own
GROQ_MODEL=openai/gpt-oss-20b
LLM_TEMPERATURE=0
LLM_SEED=7
LLM_TIMEOUT_SECONDS=45
LLM_MAX_ATTEMPTS=3
LLM_RETRY_BASE_SECONDS=1.0
# json_object (default, widest model support) or json_schema
LLM_RESPONSE_FORMAT=json_object

# ── Query guard rails ──────────────────────────────────────────────────────────
MAX_ROW_QUERY_LIMIT=200
MAX_RESULT_ROWS=5000
SQL_CACHE_TTL_SECONDS=300
SQL_CACHE_MAX_ENTRIES=64
PROMPT_MAX_VALUES_PER_FIELD=25

# ── Analytics engine ───────────────────────────────────────────────────────────
MAX_SUB_QUESTIONS=5
MAX_PARALLEL_WORKERS=1
ENABLE_SQL_REPAIR=true
ENABLE_RESPONSE_VALIDATOR=true
INSIGHT_LLM_NARRATIVE=true

# ── Persistent question-answer cache ───────────────────────────────────────────
# Complete chatbot answers
QA_CACHE_ENABLED=true
QA_CACHE_PATH=data/QA.json
QA_CACHE_MAX_ENTRIES=500
QA_CACHE_MAX_ENTRY_KB=768
QA_CACHE_MAX_AGE_HOURS=24

# Individual LLM decisions
LLM_MEMO_ENABLED=true
LLM_MEMO_PATH=data/llm_memo.json
LLM_MEMO_MAX_ENTRIES=2000
LLM_MEMO_TTL_HOURS=0

# ── Outlook drafts ─────────────────────────────────────────────────────────────
INSIGHT_MAIL_CLIENT=outlook_web
INSIGHT_MAIL_CC=

LOG_LEVEL=INFO

